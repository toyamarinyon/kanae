#!/bin/sh

set -eu

KANAE_VERSION=${KANAE_VERSION:-}
KANAE_INSTALL_ORIGIN=${KANAE_INSTALL_ORIGIN:-https://kanae.ultrahope.dev}
KANAE_RELEASE_BASE_URL=${KANAE_RELEASE_BASE_URL:-https://github.com/toyamarinyon/kanae/releases/download}
KANAE_INSTALL_ROOT=${KANAE_INSTALL_ROOT:-"$HOME/Applications/kanae"}
KANAE_SKIP_SETUP=${KANAE_SKIP_SETUP:-0}
KANAE_SETUP_WAIT_ACCESSIBILITY_SECONDS=${KANAE_SETUP_WAIT_ACCESSIBILITY_SECONDS:-}

step() {
  if [ -t 1 ]; then
    printf '→ %s' "$1"
  else
    printf '→ %s\n' "$1"
  fi
}

done_step() {
  if [ -t 1 ]; then
    printf '\r\033[K✓ %s\n' "$1"
  else
    printf '✓ %s\n' "$1"
  fi
}

if [ -z "$KANAE_VERSION" ]; then
  LATEST_JSON=$(curl -fsSL "${KANAE_INSTALL_ORIGIN%/}/latest.json")
  KANAE_VERSION=$(printf '%s' "$LATEST_JSON" | sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)
  if [ -z "$KANAE_VERSION" ]; then
    echo "error: could not resolve latest kanae version" >&2
    exit 1
  fi
fi

OS=$(uname -s)
if [ "$OS" != "Darwin" ]; then
  echo "error: hosted installer currently supports macOS only" >&2
  exit 1
fi

ARCH=$(uname -m)
case "$ARCH" in
  arm64)
    KANAE_PLATFORM="macos-arm64"
    ;;
  x86_64)
    KANAE_PLATFORM="macos-x86_64"
    ;;
  *)
    echo "error: unsupported architecture: $ARCH" >&2
    exit 1
    ;;
esac

ARCHIVE_NAME="kanae-v${KANAE_VERSION}-${KANAE_PLATFORM}.tar.gz"
if [ -n "${KANAE_BASE_URL:-}" ]; then
  ARCHIVE_URL="${KANAE_BASE_URL%/}/${ARCHIVE_NAME}"
else
  ARCHIVE_URL="${KANAE_RELEASE_BASE_URL%/}/kanae-v${KANAE_VERSION}/${ARCHIVE_NAME}"
fi
CHECKSUM_URL="${ARCHIVE_URL}.sha256"

TMP_DIR=$(mktemp -d)
trap 'rm -rf "$TMP_DIR"' EXIT

ARCHIVE_PATH="$TMP_DIR/$ARCHIVE_NAME"
CHECKSUM_PATH="$TMP_DIR/$ARCHIVE_NAME.sha256"

echo "Installing kanae $KANAE_VERSION ($KANAE_PLATFORM)"
step "Downloading $ARCHIVE_NAME"
curl -fsSL "$ARCHIVE_URL" -o "$ARCHIVE_PATH"
done_step "Downloaded $ARCHIVE_NAME"

if curl -fsSL "$CHECKSUM_URL" -o "$CHECKSUM_PATH"; then
  step "Verifying checksum"
  (cd "$TMP_DIR" && shasum -a 256 -c "$ARCHIVE_NAME.sha256" >/dev/null)
  done_step "Checksum verified"
else
  echo "Checksum: unavailable" >&2
fi

EXTRACT_DIR="$TMP_DIR/extract"
mkdir -p "$EXTRACT_DIR"
step "Extracting archive"
tar -xzf "$ARCHIVE_PATH" -C "$EXTRACT_DIR"
done_step "Extracted archive"

if [ ! -x "$EXTRACT_DIR/bin/kanae" ]; then
  echo "error: extracted archive does not contain expected binary" >&2
  exit 1
fi
if [ ! -x "$EXTRACT_DIR/Kanae.app/Contents/MacOS/Kanae" ] || [ ! -f "$EXTRACT_DIR/Kanae.app/Contents/Info.plist" ]; then
  echo "error: extracted archive does not contain expected app bundle" >&2
  exit 1
fi

step "Installing files"
mkdir -p "$KANAE_INSTALL_ROOT/bin"
cp "$EXTRACT_DIR/bin/kanae" "$KANAE_INSTALL_ROOT/bin/kanae"
mkdir -p "$KANAE_INSTALL_ROOT"
rm -rf "$KANAE_INSTALL_ROOT/Kanae.app"
cp -R "$EXTRACT_DIR/Kanae.app" "$KANAE_INSTALL_ROOT/"

if [ ! -x "$KANAE_INSTALL_ROOT/bin/kanae" ] || [ ! -x "$KANAE_INSTALL_ROOT/Kanae.app/Contents/MacOS/Kanae" ] || [ ! -f "$KANAE_INSTALL_ROOT/Kanae.app/Contents/Info.plist" ]; then
  echo "error: installed files are missing or not runnable" >&2
  exit 1
fi
done_step "Installed $KANAE_INSTALL_ROOT"

if [ "$KANAE_SKIP_SETUP" = "1" ]; then
  echo "✓ Setup skipped"
  echo "Next: $KANAE_INSTALL_ROOT/bin/kanae install"
  exit 0
fi

if [ -n "$KANAE_SETUP_WAIT_ACCESSIBILITY_SECONDS" ]; then
  if ! "$KANAE_INSTALL_ROOT/bin/kanae" install --wait-accessibility "$KANAE_SETUP_WAIT_ACCESSIBILITY_SECONDS"; then
    echo "error: install failed. run \"$KANAE_INSTALL_ROOT/bin/kanae install --wait-accessibility $KANAE_SETUP_WAIT_ACCESSIBILITY_SECONDS\" to retry" >&2
    exit 1
  fi
else
  if ! "$KANAE_INSTALL_ROOT/bin/kanae" install; then
    echo "error: install failed. run \"$KANAE_INSTALL_ROOT/bin/kanae install\" to retry" >&2
    exit 1
  fi
fi

echo ""
echo "✓ Setup complete! Kanae bindings are ready."
echo "  Document: https://github.com/toyamarinyon/kanae"
